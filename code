<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Minecraft Music</title>

<style>
body{
    background:#111;
    color:white;
    font-family:Arial,sans-serif;
    max-width:900px;
    margin:auto;
    padding:30px;
}

.song{
    background:#222;
    padding:15px;
    margin:15px 0;
    border-radius:10px;
}

button{
    padding:8px 14px;
    cursor:pointer;
}

audio{
    width:100%;
    margin:10px 0;
}
</style>
</head>

<body>

<h1>Music Library</h1>

<div id="songs"></div>

<script>

const owner = "shawnobro217-art";
const repo = "music-for-minecraft";

fetch(`https://api.github.com/repos/${owner}/${repo}/contents`)
.then(r=>r.json())
.then(files=>{

const container=document.getElementById("songs");

files
.filter(f=>/\.(mp3|ogg|wav)$/i.test(f.name))
.forEach(file=>{

const div=document.createElement("div");
div.className="song";

const encoded=file.name
.split("/")
.map(encodeURIComponent)
.join("/");

const pagesURL=`https://${owner}.github.io/${repo}/${encoded}`;

div.innerHTML=`
<h2>${file.name}</h2>

<audio controls>
<source src="${pagesURL}">
</audio>

<button onclick="navigator.clipboard.writeText('${pagesURL}')">
Copy Link
</button>
`;

container.appendChild(div);

});

});

</script>

</body>
</html>
